{
  "node": {
    "retainOps": 256,
    "syncBatchSize": 4096
  },
  "runtime": {
    "maxOldSpaceSizeMb": 15360
  },
  "cluster": {
    "syncMs": 2500,
    "forwardTimeoutMs": 60000,
    "replicationTimeoutMs": 60000,
    "hints": {
      "enabled": true,
      "debounceMs": 25,
      "maxScopesPerHint": 128
    },
    "secret": "local-dev-cluster-secret-change-me",
    "shardMapStore": {
      "mode": "s3",
      "prefix": "spread-db",
      "key": "cluster/shard-map.json"
    }
  },
  "auth": {
    "jwtSecret": "local-dev-jwt-secret-change-me",
    "accessTokenTtlSeconds": 3600,
    "refreshTokenTtlSeconds": 1209600,
    "users": [
      {
        "_id": "admin",
        "username": "admin",
        "password": "123",
        "role": "admin"
      }
    ]
  },
  "persistence": {
    "mode": "s3",
    "prefix": "spread-db",
    "flushMs": 5000,
    "opBatchSize": 1000,
    "snapshotMs": 60000,
    "segmentBytes": 16777216,
    "compactJournals": true,
    "snapshotRetention": {
      "keepLatest": 5
    },
    "restoreMode": "scoped",
    "s3": {
      "bucket": "spread-db",
      "endpoint": "http://localhost:9000",
      "region": "us-east-1",
      "accessKeyId": "minioadmin",
      "secretAccessKey": "minioadmin",
      "forcePathStyle": true
    }
  }
}
