{
  "node": {
    "id": "node-a",
    "url": "http://localhost:8080",
    "retainOps": 256,
    "syncBatchSize": 50000
  },
  "server": {
    "port": 8080
  },
  "storage": {
    "engine": "object",
    "object": {
      "valueDirectory": {
        "enabled": true,
        "minRefs": 2,
        "maxEntries": 100000,
        "maxCandidates": 4096,
        "maxCandidatesPerPath": 256,
        "maxPaths": 1024,
        "maxStringLength": 256,
        "maxKeyBytes": 512
      }
    }
  },
  "cluster": {
    "syncMs": 2500,
    "forwardTimeoutMs": 60000,
    "replicationTimeoutMs": 60000,
    "hints": {
      "enabled": true,
      "debounceMs": 25,
      "maxScopesPerHint": 128
    },
    "shardMapStore": {
      "mode": "s3",
      "prefix": "spread-db",
      "key": "cluster/shard-map.json"
    }
  },
  "auth": {
    "jwtSecret": "local-dev-jwt-secret-change-me",
    "accessTokenTtlSeconds": 900,
    "refreshTokenTtlSeconds": 1209600,
    "users": [
      {
        "_id": "admin",
        "username": "admin",
        "password": "123",
        "role": "admin"
      }
    ]
  },
  "persistence": {
    "mode": "s3",
    "prefix": "spread-db",
    "flushMs": 1000,
    "opBatchSize": 10000,
    "snapshotMs": 3600000,
    "snapshotDirtyOnly": true,
    "snapshotRole": "primary",
    "segmentBytes": 16777216,
    "compactJournals": true,
    "restoreMode": "scoped",
    "ack": "localWal",
    "localWal": {
      "mode": "on",
      "dir": ".spread-db/wal",
      "fsync": true,
      "flushMs": 1000
    },
    "s3": {
      "bucket": "spread-db",
      "endpoint": "http://localhost:9000",
      "region": "us-east-1",
      "accessKeyId": "minioadmin",
      "secretAccessKey": "minioadmin",
      "forcePathStyle": true
    }
  }
}
