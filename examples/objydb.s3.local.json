{
  "node": {
    "id": "node-a",
    "url": "http://localhost:8080",
    "retainOps": 256,
    "syncBatchSize": 50000
  },
  "server": {
    "port": 8080
  },
  "runtime": {
    "maxOldSpaceSizeMb": 15360
  },
  "memoryGuard": {
    "enabled": true
  },
  "storage": {
    "engine": "object",
    "object": {
      "valueDirectory": {
        "enabled": true,
        "minRefs": 2,
        "maxEntries": 100000,
        "maxCandidates": 4096,
        "maxCandidatesPerPath": 256,
        "maxPaths": 1024,
        "maxStringLength": 256,
        "maxKeyBytes": 512
      }
    }
  },
  "files": {
    "mode": "s3",
    "prefix": "objydb/files"
  },
  "cluster": {
    "syncMs": 2500,
    "forwardTimeoutMs": 60000,
    "replicationTimeoutMs": 60000,
    "hints": {
      "enabled": true,
      "debounceMs": 25,
      "maxScopesPerHint": 128
    },
    "shardMapStore": {
      "mode": "s3",
      "prefix": "objydb",
      "key": "cluster/shard-map.json"
    }
  },
  "auth": {
    "accessTokenTtlSeconds": 3600,
    "refreshTokenTtlSeconds": 1209600
  },
  "persistence": {
    "mode": "s3",
    "prefix": "objydb",
    "flushMs": 5000,
    "opBatchSize": 10000,
    "snapshotMs": 3600000,
    "snapshotDirtyOnly": true,
    "snapshotRole": "primary",
    "segmentBytes": 16777216,
    "compactJournals": true,
    "snapshotRetention": {
      "keepLatest": 5
    },
    "ack": "localWal",
    "localWal": {
      "mode": "on",
      "dir": ".objydb/wal",
      "fsync": true,
      "flushMs": 5000
    },
    "s3": {
      "bucket": "objydb",
      "endpoint": "http://localhost:9000",
      "region": "us-east-1",
      "accessKeyId": "minioadmin",
      "secretAccessKey": "minioadmin",
      "forcePathStyle": true
    }
  }
}
