{
  "node": {
    "id": "node-a",
    "url": "http://localhost:8080",
    "retainOps": 256,
    "syncBatchSize": 1024
  },
  "server": {
    "port": 8080
  },
  "runtime": {
    "maxOldSpaceSizeMb": 15360
  },
  "memoryGuard": {
    "enabled": true
  },
  "cluster": {
    "syncMs": 2500,
    "forwardTimeoutMs": 60000,
    "replicationTimeoutMs": 60000,
    "hints": {
      "enabled": true,
      "debounceMs": 25,
      "maxScopesPerHint": 128
    },
    "shardMapStore": {
      "mode": "off",
      "prefix": "objydb",
      "key": "cluster/shard-map.json"
    }
  },
  "auth": {
    "accessTokenTtlSeconds": 3600,
    "refreshTokenTtlSeconds": 1209600
  },
  "persistence": {
    "mode": "off",
    "prefix": "objydb",
    "flushMs": 5000,
    "opBatchSize": 1000,
    "snapshotMs": 60000,
    "segmentBytes": 16777216,
    "compactJournals": true
  }
}
