{
  "name": "@objy/server",
  "version": "0.1.0",
  "private": true,
  "description": "OBJY DB server: an in-memory, sharded and replicated database for dynamic JavaScript objects.",
  "keywords": [
    "database",
    "in-memory",
    "object-database",
    "nosql",
    "indexes",
    "aggregation",
    "vector-search",
    "server",
    "sharding",
    "replication",
    "s3"
  ],
  "type": "module",
  "main": "src/api.js",
  "exports": {
    ".": "./src/api.js",
    "./hooks": "./src/object-hooks.js"
  },
  "files": [
    "public/objy-db-logo.png",
    "src/",
    "API.md",
    "LICENSE",
    "NOTICE.md",
    "objydb.config.json",
    "public/ui/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js ui/tests/*.test.mjs",
    "test:ui": "playwright test browser-tests/ui.spec.js",
    "test:package": "node scripts/verify-release.js",
    "test:scale": "node scripts/run-server-benchmark.js",
    "test:scale:million": "node scripts/run-server-benchmark.js --objects=1000000",
    "test:stress:million": "node stress/million.js",
    "test:stress:persistence": "node stress/persistence-million.js",
    "test:stress:reshard": "node stress/reshard-restart-million.js",
    "test:stress:sharded": "node stress/sharded-persistence-million.js",
    "benchmark:storage": "node --expose-gc benchmarks/storage-engines.js",
    "benchmark:tiering": "node --expose-gc benchmarks/compressed-tiering.js",
    "package:release": "node scripts/build-release.js",
    "check:package": "node scripts/check-package.js",
    "build:ui": "npm run build --workspace=ui -- --server",
    "dev:ui": "npm run dev --workspace=ui",
    "pretest": "npm run build:ui",
    "pretest:ui": "npm run build:ui",
    "test:ui:manual": "npm run test:browser --workspace=ui",
    "pretest:scale": "npm run build:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "SPOO Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objy-org/objy.git"
  },
  "bugs": {
    "url": "https://github.com/objy-org/objy/issues"
  },
  "homepage": "https://github.com/objy-org/objy#readme",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0"
  },
  "devDependencies": {
    "@objy/client": "0.1.0",
    "@playwright/test": "^1.65.0"
  },
  "workspaces": [
    "ui"
  ]
}
