{
  "name": "objydb",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "OBJY DB: an in-memory, sharded and replicated database for dynamic JavaScript objects.",
  "type": "module",
  "main": "src/core.js",
  "exports": {
    ".": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.js"
    },
    "./hooks": "./src/object-hooks.js",
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./server": "./src/api.js"
  },
  "bin": {
    "objy": "bin/objy.js",
    "objydb": "bin/objy.js"
  },
  "files": [
    "bin/",
    "client/",
    "public/index.html",
    "public/objy-db-logo.png",
    "src/",
    "API.md",
    "LICENSE",
    "NOTICE.md",
    "objydb.config.json"
  ],
  "scripts": {
    "start": "node bin/objy.js run",
    "cluster:local": "node bin/objy.js start --instances 4",
    "test": "node --test",
    "test:client": "node --test test/client*.test.js",
    "test:browser": "npm run package:variants && playwright test",
    "test:packages": "node scripts/verify-release-variants.js",
    "test:stress:million": "node stress/million.js",
    "test:stress:persistence": "node stress/persistence-million.js",
    "test:stress:reshard": "node stress/reshard-restart-million.js",
    "test:stress:sharded": "node stress/sharded-persistence-million.js",
    "benchmark:storage": "node --expose-gc benchmarks/storage-engines.js",
    "benchmark:tiering": "node --expose-gc benchmarks/compressed-tiering.js",
    "package:variants": "node scripts/build-release-variants.js",
    "check:package": "node scripts/check-package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "SPOO Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objy-org/objy.db.git"
  },
  "bugs": {
    "url": "https://github.com/objy-org/objy.db/issues"
  },
  "homepage": "https://github.com/objy-org/objy.db#readme",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
