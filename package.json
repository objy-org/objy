{
  "name": "objydb",
  "version": "0.1.0",
  "description": "OBJY DB: an in-memory, sharded and replicated database for dynamic JavaScript objects.",
  "type": "module",
  "main": "src/api.js",
  "exports": {
    ".": "./src/api.js",
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.js"
    },
    "./hooks": "./src/object-hooks.js",
    "./server": "./src/server.js"
  },
  "bin": {
    "objydb": "bin/objydb.js"
  },
  "files": [
    "bin/",
    "client/",
    "public/index.html",
    "public/objy-db-logo.png",
    "src/",
    "API.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "start": "node bin/objydb.js",
    "cluster:local": "node scripts/local-cluster.js",
    "test": "node --test",
    "test:client": "node --test test/client*.test.js",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "SPOO Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spoo-technologies/objy-db.git"
  },
  "bugs": {
    "url": "https://github.com/spoo-technologies/objy-db/issues"
  },
  "homepage": "https://github.com/spoo-technologies/objy-db#readme",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
